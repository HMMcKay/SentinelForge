# Browser requests use same-origin paths by default. Set only for a separately hosted API.
VITE_API_BASE_URL=/api/v1
# Vite's development proxy target; this value is not included in the browser bundle.
VITE_DEV_BACKEND_URL=http://localhost:8000
# Optional explicit WebSocket URL, for example ws://localhost:8000/api/v1/live.
VITE_LIVE_URL=
