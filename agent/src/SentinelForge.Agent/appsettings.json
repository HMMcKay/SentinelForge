{
  "Agent": {
    "BaseUrl": "http://127.0.0.1:8000",
    "EnrollmentPath": "/api/v1/sensors/enroll",
    "IngestionPath": "/api/v1/events/batch",
    "HeartbeatPathTemplate": "/api/v1/sensors/{sensor_id}/heartbeat",
    "EnrollmentToken": "",
    "SensorName": "",
    "EventSource": "sysmon",
    "SysmonChannel": "Microsoft-Windows-Sysmon/Operational",
    "BatchSize": 100,
    "PollIntervalSeconds": 2,
    "HeartbeatIntervalSeconds": 30,
    "RequestTimeoutSeconds": 15,
    "MaxRetryAttempts": 5,
    "RetryBaseDelayMilliseconds": 500,
    "RetryMaxDelaySeconds": 30,
    "SpoolDirectory": "%ProgramData%\\SentinelForge\\spool",
    "SpoolMaxBytes": 268435456,
    "IdentityPath": "%ProgramData%\\SentinelForge\\identity.bin",
    "CursorPath": "%ProgramData%\\SentinelForge\\cursor.txt",
    "HealthPath": "%ProgramData%\\SentinelForge\\health.json",
    "AllowInsecureHttp": false,
    "AllowPlaintextIdentityForTests": false
  }
}
