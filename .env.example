# Copy to .env for local use. The defaults bind only to loopback.
SENTINELFORGE_BIND_ADDRESS=127.0.0.1
SENTINELFORGE_API_PORT=8000
SENTINELFORGE_WEB_PORT=8080

POSTGRES_DB=sentinelforge
POSTGRES_USER=sentinelforge
# Required: replace before first start with a URL-safe value. Compose rejects an empty value.
POSTGRES_PASSWORD=change-this-local-password

# Required credentials. Use independent URL-safe random values of at least 32 characters.
SENTINELFORGE_ENROLLMENT_KEY=change-this-enrollment-secret-at-least-32-chars
SENTINELFORGE_ADMIN_KEY=change-this-admin-secret-at-least-32-chars
SENTINELFORGE_TOKEN_PEPPER=change-this-token-pepper-at-least-32-chars
# Development-only convenience. Simulations remain dry-run unless lab mode is explicitly enabled.
SENTINELFORGE_LAB_MODE=0
SENTINELFORGE_LOG_LEVEL=INFO
SENTINELFORGE_RETENTION_DAYS=30
SENTINELFORGE_MAX_BATCH_EVENTS=500
SENTINELFORGE_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
